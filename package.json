{
  "name": "prospect-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:web": "turbo run dev --filter=@prospect-ai/web",
    "dev:api": "turbo run dev --filter=@prospect-ai/api",
    "db:push": "turbo run db:push --filter=@prospect-ai/api",
    "db:generate": "turbo run db:generate --filter=@prospect-ai/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
