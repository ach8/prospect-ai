// Prisma Schema — ProspectAI
// Multi-tenant SaaS de Prospection IA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Multi-Tenancy
// ============================================

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  plan               Plan     @default(FREE)
  aiCreditsRemaining Int      @default(100)
  maxUsers           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users         User[]
  prospectLists ProspectList[]
  campaigns     Campaign[]
  mailboxes     Mailbox[]
  agentTasks    AgentTask[]
  csvImportJobs CsvImportJob[]
  researchJobs  ResearchJob[]
  folders            Folder[]
  knowledgeDocuments KnowledgeDocument[]
  promptTemplates    PromptTemplate[]

  @@map("tenants")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  name      String
  password  String?
  role      UserRole @default(MEMBER)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ============================================
// Prospects & Folders
// ============================================

model Folder {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospectLists ProspectList[]
  campaigns     Campaign[]

  @@index([tenantId])
  @@map("folders")
}

model ProspectList {
  id        String   @id @default(uuid())
  tenantId  String
  folderId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder    Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  prospects ProspectListEntry[]
  csvImportJobs CsvImportJob[]
  researchJobs  ResearchJob[]

  @@index([tenantId])
  @@map("prospect_lists")
}

model Prospect {
  id              String         @id @default(uuid())
  tenantId        String
  firstName       String
  lastName        String
  email           String?
  emailVerified   Boolean        @default(false)
  emailConfidence Int            @default(0)
  phone           String?
  linkedinUrl     String?
  companyName     String
  companyDomain   String?
  jobTitle        String?
  industry        String?
  location        String?
  enrichmentData  Json?
  source          ProspectSource @default(MANUAL)
  csvImportJobId  String?
  researchJobId   String?
  callStatus      CallStatus     @default(UNCALLED)
  callNotes       String?        @db.Text
  lastCalledAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lists             ProspectListEntry[]
  campaignProspects CampaignProspect[]
  csvImportJob      CsvImportJob?       @relation(fields: [csvImportJobId], references: [id], onDelete: SetNull)
  researchJob       ResearchJob?        @relation(fields: [researchJobId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@index([companyDomain])
  @@map("prospects")
}

enum ProspectSource {
  GOOGLE_SEARCH
  GOOGLE_PLACES
  SCRAPING
  OPEN_DATA
  LINKEDIN
  MANUAL
  API_IMPORT
}

enum CallStatus {
  UNCALLED
  SKIPPED
  VOICEMAIL
  CALL_BACK
  NOT_INTERESTED
  INTERESTED
  WRONG_NUMBER
}

model ProspectListEntry {
  id             String @id @default(uuid())
  prospectId     String
  prospectListId String

  prospect     Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectList ProspectList @relation(fields: [prospectListId], references: [id], onDelete: Cascade)

  @@unique([prospectId, prospectListId])
  @@map("prospect_list_entries")
}

// ============================================
// Campaigns
// ============================================

model Campaign {
  id        String         @id @default(uuid())
  tenantId  String
  userId    String
  folderId  String?
  name      String
  status    CampaignStatus @default(DRAFT)
  aiConfig  Json           @default("{}")
  startDate DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id])
  folder    Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  steps              SequenceStep[]
  prospects          CampaignProspect[]
  knowledgeDocuments KnowledgeDocument[]

  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

model SequenceStep {
  id            String       @id @default(uuid())
  campaignId    String
  stepOrder     Int
  channel       Channel      @default(EMAIL)
  templateType  TemplateType @default(AI_GENERATED)
  agentType     AgentType    @default(FIRST_TOUCH)
  aiPrompt      String?      @db.Text
  subject       String?
  manualContent String?      @db.Text
  delayHours    Int          @default(0)

  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  generatedMessages GeneratedMessage[]

  @@index([campaignId])
  @@map("sequence_steps")
}

enum Channel {
  EMAIL
  LINKEDIN
  SMS
  CALL
}

enum TemplateType {
  AI_GENERATED
  MANUAL
  HYBRID
}

model CampaignProspect {
  id                  String                 @id @default(uuid())
  campaignId          String
  prospectId          String
  status              CampaignProspectStatus @default(PENDING)
  personalizedSubject String?
  personalizedBody    String?
  currentStep         Int                    @default(0)
  lastContactedAt     DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  campaign Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect Prospect           @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  events   EmailEvent[]
  messages GeneratedMessage[]

  @@unique([campaignId, prospectId])
  @@index([status])
  @@map("campaign_prospects")
}

enum CampaignProspectStatus {
  PENDING
  IN_PROGRESS
  CONTACTED
  REPLIED
  CONVERTED
  FAILED
  OPTED_OUT
}

model EmailEvent {
  id                 String         @id @default(uuid())
  campaignProspectId String
  eventType          EmailEventType
  metadata           Json?
  occurredAt         DateTime       @default(now())

  campaignProspect CampaignProspect @relation(fields: [campaignProspectId], references: [id], onDelete: Cascade)

  @@index([campaignProspectId])
  @@index([eventType])
  @@map("email_events")
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  SPAM_REPORTED
}

// ============================================
// Mailboxes
// ============================================

model Mailbox {
  id                String   @id @default(uuid())
  tenantId          String
  emailAddress      String
  smtpHost          String
  smtpPort          Int      @default(587)
  smtpUser          String
  smtpPassEncrypted String
  dailyLimit        Int      @default(50)
  warmupLevel       Int      @default(0)
  isActive          Boolean  @default(true)
  healthScore       Float    @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("mailboxes")
}

// ============================================
// AI Agent Tasks (Job tracking)
// ============================================

model AgentTask {
  id          String          @id @default(uuid())
  tenantId    String
  agentName   String
  status      AgentTaskStatus @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  tokensUsed  Int             @default(0)
  durationMs  Int             @default(0)
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([agentName])
  @@map("agent_tasks")
}

enum AgentTaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// Asynchronous Research Jobs
// ============================================

model ResearchJob {
  id                 String             @id @default(uuid())
  tenantId           String
  prompt             String             @db.Text
  targetCount        Int                @default(100)
  foundCount         Int                @default(0)
  processedCount     Int                @default(0)
  status             ResearchJobStatus  @default(PENDING)
  blacklistedDomains Json               @default("[]")
  options            Json               @default("{}")
  listId             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list      ProspectList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  prospects Prospect[]

  @@index([tenantId])
  @@index([status])
  @@map("research_jobs")
}

enum ResearchJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// CSV Data Enrichment
// ============================================

enum JobType {
  ENRICHMENT
  CLEANER
  IMPORT
}

model CsvImportJob {
  id            String          @id @default(uuid())
  tenantId      String
  filename      String
  jobType       JobType         @default(ENRICHMENT)
  status        ImportJobStatus @default(PENDING)
  totalRows     Int             @default(0)
  processedRows       Int             @default(0)
  enrichedRows        Int             @default(0)
  failedRows          Int             @default(0)
  emailsFoundSearch   Int             @default(0)
  emailsFoundAnymail  Int             @default(0)
  emailsFoundDatabase Int             @default(0)
  emailsNotFound      Int             @default(0)
  listId              String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list      ProspectList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  prospects Prospect[]

  @@index([tenantId])
  @@index([status])
  @@map("csv_import_jobs")
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Multi-Agent Copywriting & RAG
// ============================================

enum AgentType {
  SUBJECT
  FIRST_TOUCH
  FOLLOW_UP
  CLOSER
  VISUAL_AUDIT
}

model GeneratedMessage {
  id                 String                 @id @default(uuid())
  campaignProspectId String
  sequenceStepId     String
  subject            String?
  body               String
  status             GeneratedMessageStatus @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  campaignProspect CampaignProspect @relation(fields: [campaignProspectId], references: [id], onDelete: Cascade)
  sequenceStep     SequenceStep     @relation(fields: [sequenceStepId], references: [id], onDelete: Cascade)

  @@index([campaignProspectId])
  @@index([sequenceStepId])
  @@index([status])
  @@map("generated_messages")
}

enum GeneratedMessageStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
}

model KnowledgeDocument {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String?
  name       String
  content    String   // Extracted text content or system prompt
  fileUrl    String?  // Original file if uploaded
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
  @@map("knowledge_documents")
}

model PromptTemplate {
  id                String    @id @default(uuid())
  tenantId          String
  name              String
  description       String?   @db.Text
  globalContext     String?   @db.Text
  visualAuditPrompt String?   @db.Text
  campaignObjective String?   @db.Text
  steps             Json?     @default("[]")
  subjectPrompt     String?   @db.Text
  firstTouchPrompt  String?   @db.Text
  followUpPrompt    String?   @db.Text
  closerPrompt      String?   @db.Text
  isDefault         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("prompt_templates")
}

