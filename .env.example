# ============================================
# ProspectAI — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/prospectai?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# Google Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Google Places API (for Research Agent)
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# Hunter.io (for Email Finder Agent)
HUNTER_API_KEY="your-hunter-api-key"

# ZeroBounce (for Email Verification)
ZEROBOUNCE_API_KEY="your-zerobounce-api-key"

# Email Sending
SMTP_DEFAULT_FROM="noreply@yourcompany.com"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# API Port
PORT=4000
